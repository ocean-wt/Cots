# ---------------------------------------------------------------------------
# Cots backend configuration (copy to .env)
# docker-compose provides all of these automatically for the container stack.
# ---------------------------------------------------------------------------

ENV=dev

# Storage — MySQL 8.0 in docker; sqlite+aiosqlite works for local quickstart.
DATABASE_URL=mysql+aiomysql://cots:change-me@mysql:3306/cots
# DATABASE_URL=sqlite+aiosqlite:///./data/cots.db

REDIS_URL=redis://redis:6379/0

# Vector store — leave unset for embedded milvus-lite (local); docker uses
# MILVUS_HOST=milvus against the standalone service. Do not set COTS_MILVUS_URI
# to a server URL in docker (pymilvus reserves the MILVUS_URI name itself).
# COTS_MILVUS_URI=/data/milvus_lite.db
MILVUS_HOST=milvus
MILVUS_PORT=19530

# Embeddings (downloaded through the HF mirror; switch for offline clusters)
HF_ENDPOINT=https://hf-mirror.com
EMBED_MODEL=Xenova/bge-small-zh-v1.5
EMBED_DIM=512

# Retrieval / rerank
RETRIEVAL_TOP_K=20
RRF_K=60
RERANK_THRESHOLD=0.40

# LLM — auto picks openai -> anthropic -> deterministic rule engine.
# With no key configured the system still runs end-to-end on real tools with
# the deterministic supervisor/synthesizer.
LLM_PROVIDER=auto
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Auth (must match GATEWAY_JWT_SECRET)
JWT_SECRET=change-me
JWT_ALGORITHM=HS256

# Agent orchestration
AGENT_MAX_ROUNDS=2
AGENT_NODE_TIMEOUT_SEC=60
SSE_IDLE_TIMEOUT_SEC=45

SEED_ON_STARTUP=true

# Edge trust (gateway<->backend shared secret; must match GATEWAY_INTERNAL_TOKEN)
GATEWAY_INTERNAL_TOKEN=change-me
ALLOW_DEV_PRINCIPAL=false
REQUIRE_INTERNAL_AUTH=true

# Hardening
INPUT_MAX_CHARS=4000
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20